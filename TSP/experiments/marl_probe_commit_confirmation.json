    "independent_controller_vs_q8_lower_confidence_bound_min": -0.02,
    "shared_controller_vs_q8_lower_confidence_bound_min": 0.0,
    "shared_controller_vs_q8_mean_min": 0.04,
    "shared_controller_vs_q1_lower_confidence_bound_min": -0.02,
    "mixture_controller_vs_q8_lower_confidence_bound_min": 0.0,
    "mixture_controller_vs_q8_mean_min": 0.02,
    "probe_message_fraction_max": 0.01,
    "controller_wall_clock_overhead_fraction_max": 0.05,
    "marginal_preserving_coupling_audit": true
