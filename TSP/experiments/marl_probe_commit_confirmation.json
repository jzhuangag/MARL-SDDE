    "gate_sha256": "0f12063dc9725308a2d1c24174360ece9ef6cd295a31a1bcbfdf0a710d585c04",
    "decision": "authorize-confirmation-preregistration"
  },
  "upstream": {
    "repository": "https://github.com/PKU-MARL/HARL",
    "commit": "b1af98b0dbab72a2eee9d160751cd09aedbb8ce2",
    "algorithm": "mappo"
  },
  "task": {
    "environment": "pettingzoo_mpe",
    "scenario": "simple_spread_v2",
    "continuous_actions": false,
    "rollout_length": 25,
    "ctde": true,
    "decentralized_evaluation": true
  },
  "coupling_regimes": ["independent", "shared"],
  "methods": ["lyapunov_probe_commit", "fixed_q1", "fixed_q8"],
  "controller": {
